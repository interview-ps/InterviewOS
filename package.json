{
  "name": "interview-os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "dev": "corepack pnpm -r --parallel --if-present dev",
    "typecheck": "corepack pnpm -r --if-present typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:codex": "INTERVIEW_OS_LIVE_CODEX=1 vitest run live.test",
    "test:claude": "INTERVIEW_OS_LIVE_CLAUDE=1 vitest run claude-online",
    "test:opencode": "INTERVIEW_OS_LIVE_OPENCODE=1 vitest run opencode-online",
    "test:e2e": "playwright test",
    "test:e2e:live": "playwright test -c playwright.live.config.ts"
  },
  "devDependencies": {
    "@interview-os/core": "workspace:*",
    "@interview-os/orchestrator": "workspace:*",
    "@interview-os/runtime": "workspace:*",
    "@interview-os/server": "workspace:*",
    "@interview-os/shared": "workspace:*",
    "@interview-os/skills": "workspace:*",
    "@playwright/test": "^1.63.0",
    "@types/node": "24.13.6",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.1",
    "zod": "4.6.5"
  },
  "engines": {
    "node": ">=22"
  }
}
