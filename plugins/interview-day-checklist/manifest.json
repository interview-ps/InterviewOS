{
  "id": "interview-day-checklist",
  "name": "Interview Day Checklist",
  "version": "1.1.0",
  "kind": "plugin",
  "author": "interview-os",
  "description": "A short checklist for interview day: the weakest requirement areas to skim, a STAR reminder, and logistics.",
  "inputs": [
    { "key": "target", "permission": "target.read" },
    { "key": "readiness", "permission": "readiness.read" },
    { "key": "gaps", "permission": "readiness.read" }
  ],
  "outputs": ["checklist"],
  "capabilities": ["preparation"],
  "hooks": ["preparation.suggest"],
  "engines": { "interview-os": ">=0.4.0" },
  "permissions": ["target.read", "readiness.read"]
}
