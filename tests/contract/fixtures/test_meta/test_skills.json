            "compatible": true,
            "description": "Live-coding interview round — solve a small algorithmic problem, explain your approach, then write code (reviewed, not executed).",
            "engines": {
              "interview-os": ">=0.4.0",
              "plugin-api": "^1.1.0"
            },
            "hooks": [
              "mode.mock",
              "ui.render"
            ],
            "id": "coding-mode",
            "inputs": [],
            "kind": "plugin",
            "modes": [
              {
                "answerFields": [],
                "answerFormat": "text+code",
                "context": {
                  "companyThemes": false,
                  "storyTitles": false
                },
                "description": "Solve a small algorithmic problem — explain your approach, then write code (reviewed, not executed).",
                "evaluatorPrompt": "prompts/evaluator.md",
                "fallbackSkills": [
                  "coding",
                  "coding.algorithms",
                  "coding.data-structures",
                  "coding.complexity",
                  "coding.edge-cases",
                  "coding.code-quality"
                ],
                "followUpRules": [
                  {
                    "below": 0.6,
                    "focus": "complexity analysis",
                    "rubricId": "complexity"
                  },
                  {
                    "below": 0.6,
                    "focus": "edge cases",
                    "rubricId": "edgeCases"
                  }
                ],
                "id": "coding",
                "initialState": {
                  "phase": "briefing",
                  "problem": null
                },
                "interviewerPrompt": "prompts/interviewer.md",
                "label": "Coding",
                "reduce": {
                  "copyExtra": [
                    "problem"
                  ],
                  "set": {
                    "phase": "working"
                  }
                },
                "rubric": [
                  {
                    "description": "Restates the goal, clarifies inputs, constraints and edge conditions before coding.",
                    "id": "problemUnderstanding",
                    "label": "Problem understanding"
                  },
                  {
                    "description": "Describes a workable plan before or while writing code.",
                    "id": "approach",
                    "label": "Approach"
                  },
                  {
                    "description": "The proposed logic/code solves the stated problem.",
                    "id": "correctness",
                    "label": "Correctness"
                  },
                  {
                    "description": "States and reasons about time/space complexity (big-O).",
                    "id": "complexity",
                    "label": "Complexity"
                  },
                  {
                    "description": "Identifies and handles edge cases (empty input, duplicates, bounds).",
                    "id": "edgeCases",
                    "label": "Edge cases"
                  },
                  {
                    "description": "Readable, structured code — good naming, no dead paths.",
                    "id": "codeQuality",
                    "label": "Code quality"
                  },
                  {
                    "description": "Thinks aloud clearly; the interviewer could follow along.",
                    "id": "communication",
                    "label": "Communication"
                  }
                ],
                "scope": {
                  "exclude": [],
                  "include": [
                    "coding"
                  ]
                }
              }
            ],
