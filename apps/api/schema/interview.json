          "type": "string"
        },
        "plannedQuestions": {
          "maximum": 6,
          "minimum": 1,
          "title": "Plannedquestions",
          "type": "integer"
        },
        "readinessAfter": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReadinessSnapshot"
            },
            {
              "type": "null"
