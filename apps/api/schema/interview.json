          "default": null,
          "emit_null": true,
          "title": "Sessionid"
        },
        "skillDeltas": {
          "items": {
            "$ref": "#/$defs/SkillDelta"
          },
          "title": "Skilldeltas",
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/LoopRoundStatus",
          "default": "pending"
        }
      },
      "required": [
        "mode",
        "plannedQuestions"
      ],
      "title": "LoopRound",
      "type": "object"
    },
