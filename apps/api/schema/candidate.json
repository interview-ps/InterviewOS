            },
            "level": {
              "maximum": 1,
              "minimum": 0,
              "title": "Level",
              "type": "number"
            },
            "skillId": {
              "pattern": "^[a-z0-9-]+(\\.[a-z0-9-]+)*$",
              "title": "Skillid",
              "type": "string"
            },
            "source": {
              "const": "resume",
              "title": "Source",
              "type": "string"
            }
          },
          "required": [
            "skillId",
            "level",
            "source",
            "evidence"
          ],
          "title": "CandidateSkill",
          "type": "object"
        },
        "Education": {
          "properties": {
            "degree": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Degree"
            },
            "end": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "End"
            },
            "field": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Field"
            },
            "institution": {
              "title": "Institution",
              "type": "string"
            }
          },
          "required": [
            "institution"
          ],
          "title": "Education",
          "type": "object"
        },
        "Experience": {
          "properties": {
            "company": {
              "title": "Company",
              "type": "string"
            },
            "end": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "End"
            },
            "highlights": {
              "items": {
                "type": "string"
              },
              "title": "Highlights",
              "type": "array"
            },
            "start": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Start"
            },
            "title": {
              "title": "Title",
              "type": "string"
            }
          },
          "required": [
            "title",
            "company"
          ],
          "title": "Experience",
          "type": "object"
        },
        "Project": {
