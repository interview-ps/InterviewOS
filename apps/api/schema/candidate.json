              "title": "Description",
              "type": "string"
            },
            "name": {
              "title": "Name",
              "type": "string"
            },
            "technologies": {
              "items": {
                "type": "string"
              },
              "title": "Technologies",
              "type": "array"
            }
          },
          "required": [
            "name",
            "description"
          ],
          "title": "Project",
          "type": "object"
        },
        "StarStory": {
          "properties": {
            "action": {
              "title": "Action",
              "type": "string"
            },
            "id": {
              "title": "Id",
              "type": "string"
