              "title": "Skillids",
              "type": "array"
            },
            "task": {
              "title": "Task",
              "type": "string"
            },
            "title": {
              "title": "Title",
              "type": "string"
            }
          },
          "required": [
            "id",
            "title",
            "situation",
            "task",
            "action",
            "result"
          ],
          "title": "StarStory",
          "type": "object"
