            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "projects": {
          "items": {
            "$ref": "#/$defs/Project"
          },
          "title": "Projects",
          "type": "array"
        },
        "skills": {
          "items": {
            "$ref": "#/$defs/CandidateSkill"
          },
          "title": "Skills",
          "type": "array"
        },
        "starStories": {
          "items": {
            "$ref": "#/$defs/StarStory"
          },
          "title": "Starstories",
          "type": "array"
        }
      },
      "required": [
        "id"
      ],
      "title": "CandidateProfile",
      "type": "object"
    },
